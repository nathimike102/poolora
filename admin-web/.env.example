# Backend API origin. Add this app's origin to the backend's CORS_ORIGIN.
VITE_API_URL=http://localhost:5002

# Firebase web app config: Firebase console > Project settings > Your apps >
# add a Web app (same project as the mobile app). These values are public.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Map style (optional). Default: OpenFreeMap, no key needed.
# VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
