# ─── API Configuration ───────────────────────────────────────────────────────
# Backend base URL. Routes are served from the root (no /api/v1 prefix).
# Production: https://api.sanchari.me
REACT_NATIVE_API_BASE_URL=http://localhost:5002
REACT_NATIVE_API_TIMEOUT=30000

# ─── Debug Configuration ─────────────────────────────────────────────────────
DEBUG_API_CALLS=false
LOG_LEVEL=info
# Only honoured in development builds (__DEV__)
DEV_AUTH_BYPASS=false

# ─── Firebase Configuration ──────────────────────────────────────────────────
# Loaded from google-services.json / GoogleService-Info.plist; override here if needed.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ─── Google Sign-In ──────────────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=

# Used only by the native Maps SDK (app.config.js). Restrict this key in Google
# Cloud to the Android package com.sanchari.app and your signing certificate
# SHA-1, and to the iOS bundle id. Place search does not use it.
GOOGLE_MAPS_API_KEY=

# ─── EAS / Expo ──────────────────────────────────────────────────────────────
EAS_PROJECT_ID=

# ─── Error tracking (optional) ───────────────────────────────────────────────
# Leave empty to disable. Only used in release builds.
SENTRY_DSN=
