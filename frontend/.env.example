# ─── API Configuration ───────────────────────────────────────────────────────
# Backend base URL. Routes are served from the root (no /api/v1 prefix).
# REQUIRED for release builds: there is no production default, and the app
# throws at startup if this is unset in a non-dev build.
REACT_NATIVE_API_BASE_URL=http://localhost:5002
REACT_NATIVE_API_TIMEOUT=30000

# ─── Debug Configuration ─────────────────────────────────────────────────────
DEBUG_API_CALLS=false
LOG_LEVEL=info
# Only honoured in development builds (__DEV__)
DEV_AUTH_BYPASS=false

# ─── Firebase Configuration ──────────────────────────────────────────────────
# Loaded from google-services.json / GoogleService-Info.plist; override here if needed.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Realtime Database instance URL (region-specific)
FIREBASE_DATABASE_URL=

# ─── Google Sign-In ──────────────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=

# ─── Maps ────────────────────────────────────────────────────────────────────
# Maps use MapLibre with free OpenFreeMap tiles (OpenStreetMap data): no key.
# Optional: another MapLibre style URL, or MAPS_ENABLED=false for placeholders.
# MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
# MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
# MAPS_ENABLED=true

# ─── EAS / Expo ──────────────────────────────────────────────────────────────
EAS_PROJECT_ID=

# ─── Error tracking (optional) ───────────────────────────────────────────────
# Leave empty to disable. Only used in release builds.
SENTRY_DSN=

# Market this build serves (see src/utils/region.ts); must match the backend's MARKET
EXPO_PUBLIC_MARKET=ZW
