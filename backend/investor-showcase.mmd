flowchart TB
    HERO["POOLORA<br/>Unified Mobility Platform<br/>Ride pooling + parcel pooling + trip pooling in one operating system"]:::hero

    subgraph STORY["Why investors care"]
        direction LR
        P["Problem<br/>Fuel pressure<br/>Empty seats<br/>Fragmented logistics"]:::problem
        S["Solution<br/>Smart matching engine<br/>Wallet, safety, chat, payments"]:::solution
        I["Impact<br/>Lower cost<br/>Higher utilization<br/>Lower emissions"]:::impact
    end

    subgraph ENGINE["Operating system"]
        direction LR
        M["Matching engine<br/>5-factor scoring<br/>Proximity, time, rating, acceptance, safety"]:::module
        T["Trust layer<br/>KYC, ratings, SOS, emergency contacts"]:::module
        W["Wallet layer<br/>Top-up, coins, rewards, refunds"]:::module
        R["Realtime layer<br/>Chat, notifications, ride events, tracking"]:::module
    end

    subgraph VALUE["Business model"]
        direction LR
        B1["Ride commission"]:::biz
        B2["Parcel delivery fees"]:::biz
        B3["Payment and wallet flows"]:::biz
        B4["Enterprise API partnerships"]:::biz
    end

    subgraph GROWTH["Go to market"]
        direction LR
        G1["Start with dense city routes"]:::growth
        G2["Build rider + driver liquidity"]:::growth
        G3["Expand into parcels and scheduled rides"]:::growth
        G4["Add enterprise and fleet integrations"]:::growth
    end

    subgraph SCORECARD["Investor scorecard"]
        direction LR
        K1["Occupancy up"]:::metric
        K2["Fuel per trip down"]:::metric
        K3["Repeat usage up"]:::metric
        K4["Safety response faster"]:::metric
    end

    HERO --> STORY --> ENGINE --> VALUE --> GROWTH --> SCORECARD

