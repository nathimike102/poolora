# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production                  # production | development | test
PORT=5002
APP_BASE_URL=https://sanchari.me

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Generate strong password: openssl rand -base64 32
MONGO_USER=admin
MONGO_PASS=
MONGO_URI=mongodb://admin:PASSWORD@mongo:27017/mobility?authSource=admin&retryWrites=true&w=majority

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                       # openssl rand -base64 32

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 64 characters. Use different values for access and refresh.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Firebase (push notifications + authentication) ─────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json

# ─── Auth Provider ────────────────────────────────────────────────────────────
# firebase = Firebase ID tokens only
# custom   = OTP + JWT only (existing system)
# hybrid   = Firebase primary → custom JWT fallback (recommended)
AUTH_PROVIDER=hybrid

# ─── Razorpay (payments) ──────────────────────────────────────────────────────
# Use rzp_test_ prefix for test keys, rzp_live_ for production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── AWS S3 (file uploads) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mobility-uploads-prod

# ─── Twilio (SMS OTP) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Maps ─────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092           # comma-separated for multi-broker: host1:9092,host2:9092
KAFKA_CLIENT_ID=mobility-backend

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated — do NOT use * in production
CORS_ORIGIN=https://sanchari.me,https://www.sanchari.me

# ─── Platform ─────────────────────────────────────────────────────────────
PLATFORM_FEE_RATE=0.15                # 15% commission on rides (0.0 to 1.0)

# ─── FCM (Firebase Cloud Messaging) ──────────────────────────────────────────
FCM_SERVER_KEY=
