# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production                  # production | development | test
PORT=5002
# Market this deployment serves (see src/config/region.ts). ZW is the first; one deployment per market
MARKET=ZW
# Public API origin, used in links sent to people (e.g. SOS live tracking)
# Public API origin. Required in production (no default). Used in the SOS
# tracking links sent by SMS, so it must be reachable from a phone.
APP_BASE_URL=http://localhost:5002

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Generate strong password: openssl rand -base64 32
MONGO_USER=admin
MONGO_PASS=
MONGO_URI=mongodb://admin:PASSWORD@mongo:27017/mobility?authSource=admin&retryWrites=true&w=majority

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                       # openssl rand -base64 32

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 64 characters. Use different values for access and refresh.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Firebase (push notifications + authentication) ─────────────────────────
FIREBASE_PROJECT_ID=
# Realtime Database instance URL (region-specific), e.g.
# https://<project-id>-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
# Optional: instead of mounting a file, supply the JSON directly (base64-encoded or raw JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Auth Provider ────────────────────────────────────────────────────────────
# firebase = Firebase ID tokens only
# custom   = OTP + JWT only (existing system)
# hybrid   = Firebase primary → custom JWT fallback (recommended)
AUTH_PROVIDER=hybrid

# ─── Paynow (payments: EcoCash, OneMoney, InnBucks, Visa/Mastercard) ─────────
# Paynow gives one integration per currency (Paynow > Receive Payments > New
# Integration). Set the result URL there to <APP_BASE_URL>/payments/paynow/result.
PAYNOW_USD_INTEGRATION_ID=
PAYNOW_USD_INTEGRATION_KEY=
# Optional: leave empty to take US dollars only
PAYNOW_ZWG_INTEGRATION_ID=
PAYNOW_ZWG_INTEGRATION_KEY=
# Used when the payer has no email; in test mode it must be the merchant login email
PAYNOW_AUTH_EMAIL=
# ZiG per US dollar for ZiG payments; 0 turns them off. Also editable in the admin
ZWG_PER_USD=0
# Paynow endpoints; only change these if Paynow gives you different addresses
# PAYNOW_INITIATE_URL=https://www.paynow.co.zw/interface/initiatetransaction
# PAYNOW_REMOTE_URL=https://www.paynow.co.zw/interface/remotetransaction

# ─── AWS S3 (file uploads) ────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
AWS_S3_BUCKET=mobility-uploads-prod

# ─── Twilio (SMS OTP and SOS alerts) ─────────────────────────────────────────
TWILIO_ENABLED=true                   # false disables all SMS, including SOS texts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Maps ─────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
# Leave the key empty to use free OpenStreetMap services instead (no key needed).
# MAPS_PROVIDER=osm            # force 'osm' or 'google'
# PHOTON_URL=https://photon.komoot.io
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# OSM_USER_AGENT=Siham/1.0 (you@example.com)

# Dev ride simulator (POST /dev/simulate/...). On by default outside production.
# ENABLE_RIDE_SIMULATION=true

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092           # comma-separated for multi-broker: host1:9092,host2:9092
KAFKA_CLIENT_ID=mobility-backend
# KAFKA_ENABLED=false               # run without Kafka; events are then handled in-process

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── Email (optional) ───────────────────────────────────────────────────────
# Any SMTP provider. Without SMTP_HOST, receipts and notices are not emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Siham <no-reply@example.com>

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated — do NOT use * in production
# Comma-separated origins: the marketing site, and the web admin (admin-web/),
# which calls the API from the browser. Locally the admin runs on :5174.
CORS_ORIGIN=https://siham.vercel.app,http://localhost:5174

# ─── Platform ─────────────────────────────────────────────────────────────
PLATFORM_FEE_RATE=0.15                # 15% commission on rides (0.0 to 1.0)
# COIN_TO_USD_RATE=0.01               # US dollars per wallet coin


# ─── Error tracking (optional) ───────────────────────────────────
# Leave empty to disable. Phone numbers, tokens and request bodies are stripped.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=                    # optional release label
# ─── Product analytics (optional, docs/ANALYTICS_PLAN.md) ───────────────────
# PostHog project API key (phc_…). Events are sent only when NODE_ENV=production,
# so put the key in production only. The admin's Analytics page works without it.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com

# ─── Internal services ───────────────────────────────────────────────────────
# Shared with the ML service; requests without it are rejected. openssl rand -hex 32
ML_SERVICE_API_KEY=
ML_SERVICE_URL=http://siham-ml:8000

# Rank search results with the ML service's /api/match instead of the local score
# ML_MATCHING=true

# ─── Optional features (see docs/SECRETS.md) ─────────────────────────────────
# In-app support assistant (Claude). Without a key it says it is unavailable.
# ANTHROPIC_API_KEY=
# SUPPORT_BOT_MODEL=claude-opus-5-5
# Masked rider-driver calls through Twilio; recording is on unless false
# TWILIO_VOICE_NUMBER=
# CALL_RECORDING=true
# Live video during an SOS through LiveKit (wss:// project URL). Without these the app never offers it.
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# Record SOS video with the incident's evidence; off until legal advice allows it (also a platform setting)
# SOS_VIDEO_RECORDING=false
# Recording only: an IAM user allowed s3:PutObject on sos/* and nothing else (LiveKit holds these)
# LIVEKIT_RECORDING_AWS_ACCESS_KEY_ID=
# LIVEKIT_RECORDING_AWS_SECRET_ACCESS_KEY=
# Car GPS trackers through the Traccar gateway (infra/traccar). Without the key the endpoint is off.
# TRACKER_GATEWAY_KEY=
# TRACKER_GATEWAY_HOST=track.example.com
# TRACKER_GATEWAY_PORT=5023
# Background-check vendor for driver applications; it calls back /kyc-verify/callback
# KYC_VERIFY_URL=
# KYC_VERIFY_API_KEY=
# Insurer endpoint for parcel claims
# INSURANCE_CLAIMS_URL=
# INSURANCE_API_KEY=
# PARCEL_PHOTO_PROOF=optional       # stop requiring photos at parcel pickup and delivery
# KEEP_PLATFORM_FEE_ON_CANCEL=false
# ADMIN_WEB_URL=https://admin.example.com   # for links in admin alert emails
# Request limits: per IP is a ceiling (carrier NAT shares IPs), per user is the real limit
# RATE_LIMIT_IP_PER_MIN=1000
# RATE_LIMIT_USER_PER_MIN=120

# ─── Monitoring (docker-compose) ─────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=

# ─── Local development only ──────────────────────────────────────────────────
# DEV_AUTH_BYPASS=true only takes effect when NODE_ENV=development is set explicitly.
# DNS_SERVERS=8.8.8.8,8.8.4.4   # only if your resolver can't do SRV lookups for mongodb+srv
